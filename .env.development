VITE_ENABLE_MOCKS=true
VITE_API_URL=http://localhost:8080/api
# Google OAuth Client ID (must match backend's GOOGLE_CLIENT_ID; add http://localhost:5173
# as an Authorized JavaScript origin for this Client ID in Google Cloud Console)
VITE_GOOGLE_CLIENT_ID=

# Per-module mock overrides (solo aplican si VITE_ENABLE_MOCKS=false)
# VITE_MOCK_AUTH=true
# VITE_MOCK_USERS=true
# VITE_MOCK_DASHBOARD=true
# VITE_MOCK_GROUPS=true
# VITE_MOCK_PROBLEMS=true
# VITE_MOCK_SUBMISSIONS=true
# VITE_MOCK_CONTESTS=true
# VITE_MOCK_MATERIALS=true
# VITE_MOCK_TEAMS=true
